rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.email == request.auth.token.email;
      allow create: if isSignedIn() && isValidId(userId);
      allow update: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn() && isValidId(userId);
    }

    match /admissions/{admissionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(admissionId);
    }
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(materialId);
    }
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(assessmentId);
    }
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(noticeId);
    }
    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(meetingId);
    }
    match /interventions/{interventionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(interventionId);
    }
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(batchId);
    }
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(attendanceId);
    }
  }
}
